{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mi3 pronunciation dictionary manifest",
  "type": "object",
  "required": ["schema", "dictionaries"],
  "properties": {
    "schema": { "const": 1 },
    "dictionaries": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Z][a-zA-Z0-9]{1,7})?$" },
      "additionalProperties": {
        "type": "object",
        "required": ["format", "revision", "publishedAt", "entries", "url", "size", "sha256", "sourceSha256"],
        "properties": {
          "format": { "type": "integer", "minimum": 1 },
          "revision": { "type": "integer", "minimum": 1 },
          "publishedAt": { "type": "string", "format": "date-time" },
          "entries": { "type": "integer", "minimum": 1 },
          "url": { "type": "string", "pattern": "^https://github\\.com/" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
